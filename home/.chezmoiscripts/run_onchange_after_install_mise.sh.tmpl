#!/usr/bin/env bash
# config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -euo pipefail

MISE_BIN="{{ if $m := lookPath "mise" }}{{ $m }}{{ else }}{{ joinPath .chezmoi.homeDir ".local/bin/mise" }}{{ end }}"

if [[ ! -x "$MISE_BIN" ]]; then
  echo "mise not found; skipping post-install" >&2
  exit 0
fi

"$MISE_BIN" trust ~/.config/mise
"$MISE_BIN" install --yes
"$MISE_BIN" reshim

# ── Post-install bootstraps for tools that need init after binary install ──

# RTK (Rust Token Killer): mise installs the binary, but `rtk init -g` creates
# the Claude Code hook (~/.claude/hooks/rtk-rewrite.sh), RTK.md, and filters.
# Idempotent — safe to re-run. Non-interactive (defaults to N for settings.json patch).
if command -v rtk &>/dev/null; then
  if ! rtk init -g; then
    echo "WARNING: rtk init -g failed — RTK hook not installed" >&2
  fi
fi
