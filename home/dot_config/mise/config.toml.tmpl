# Mise Global Configuration — managed by chezmoi
# Source of truth: .chezmoisource/dot_config/mise/config.toml.tmpl
# Applied by: chezmoi apply → ~/.config/mise/config.toml
[settings]
experimental = true
not_found_auto_install = true
status = { missing_tools = "always" }
env_shell_expand = true

[settings.npm]
package_manager = "bun"

[settings.python]
uv_venv_auto = true

[plugins]
fnox-env = "https://github.com/jdx/mise-env-fnox"

[env]
_.fnox-env = { tools = true }
GIT_TERMINAL_PROMPT = "0"

# NotebookLM auth: standardize paths so agents find credentials consistently
NOTEBOOKLM_HOME = "~/.notebooklm"

# MDE path management — single source of truth for .generated/ structure
# Layer 1: chezmoi renders .chezmoi.sourceDir|dir to absolute repo root at `chezmoi apply`
# Layer 2: mise expands $MDE_PROJECT_DIR/$MDE_GENERATED_DIR at shell activation via env_shell_expand
# RULE: Only MDE_PROJECT_DIR uses the chezmoi template variable directly.
#       All other vars MUST compose from $MDE_PROJECT_DIR or $MDE_GENERATED_DIR.
MDE_PROJECT_DIR = "{{ .chezmoi.sourceDir | dir }}"
MDE_GENERATED_DIR = "$MDE_PROJECT_DIR/.generated"
MDE_DIR_REMEMBER = "$MDE_GENERATED_DIR/remember"
MDE_DIR_LEARNINGS = "$MDE_GENERATED_DIR/learnings"
MDE_DIR_TRANSCRIPTS = "$MDE_GENERATED_DIR/transcripts"
MDE_DIR_SCHEMAS = "$MDE_GENERATED_DIR/schemas"
MDE_DIR_REPORTS = "$MDE_GENERATED_DIR/reports"
MDE_DIR_CONTEXT = "$MDE_GENERATED_DIR/context"
MDE_DIR_DREAM = "$MDE_GENERATED_DIR/dream"

{{ if eq .chezmoi.os "darwin" -}}
{{   $brewPrefix := "/opt/homebrew" -}}
{{   if eq .chezmoi.arch "amd64" -}}
{{     $brewPrefix = "/usr/local" -}}
{{   end -}}
{{   $llvmPrefix := printf "%s/opt/llvm" $brewPrefix -}}
{{   if stat $llvmPrefix -}}
# LLVM/Clang: Homebrew's latest LLVM (clang-format, clang-tidy, lldb, lld included)
# Brew formula: https://formulae.brew.sh/formula/llvm (keg-only, needs explicit paths)
# Prefix is arch-aware: arm64=/opt/homebrew, amd64=/usr/local
_.path = ["{{ $llvmPrefix }}/bin"]
CC = "{{ $llvmPrefix }}/bin/clang"
CXX = "{{ $llvmPrefix }}/bin/clang++"
LDFLAGS = "-L{{ $llvmPrefix }}/lib -L{{ $llvmPrefix }}/lib/c++ -Wl,-rpath,{{ $llvmPrefix }}/lib/c++"
CPPFLAGS = "-I{{ $llvmPrefix }}/include -D_LIBCPP_DISABLE_AVAILABILITY"
PKG_CONFIG_PATH = "{{ $llvmPrefix }}/lib/pkgconfig"
{{   end -}}
{{ end -}}

[tools]
{{- define "toml-key" }}{{ if or (regexMatch "[:/@ ]" .) (regexMatch "^[0-9]" .) }}{{ . | quote }}{{ else }}{{ . }}{{ end }}{{ end -}}
{{- define "render-tools" }}
{{-   range . }}
{{-     if hasKey . "config" }}
{{-       $cfg := .config }}
{{-       if hasKey $cfg "symlink_bins" }}
{{ template "toml-key" .name }} = { version = {{ .version | quote }}, symlink_bins = {{ get $cfg "symlink_bins" }} }
{{-       else if hasKey $cfg "extras" }}
{{ template "toml-key" .name }} = { version = {{ .version | quote }}, extras = {{ get $cfg "extras" | quote }} }
{{-       else if hasKey $cfg "uvx_args" }}
{{ template "toml-key" .name }} = { version = {{ .version | quote }}, uvx_args = {{ get $cfg "uvx_args" | quote }} }
{{-       else }}
{{ template "toml-key" .name }} = {{ .version | quote }}
{{-       end }}
{{-     else }}
{{ template "toml-key" .name }} = {{ .version | quote }}
{{-     end }}
{{-   end }}
{{- end }}
# ── Core Runtimes ──
{{- template "render-tools" .mise.tools.core_runtimes }}

# ── Modern Rust-Based Utilities ──
{{- template "render-tools" .mise.tools.modern_utilities }}

# ── Security & Encryption ──
{{- template "render-tools" .mise.tools.security }}

# ── Data Processing ──
{{- template "render-tools" .mise.tools.data_processing }}

# ── Code Quality ──
{{- template "render-tools" .mise.tools.code_quality }}

# ── Infrastructure ──
{{- if eq .chezmoi.os "darwin" }}
{{-   template "render-tools" .mise.tools.infrastructure_darwin }}
# clang/LLVM: managed by brew (brew install llvm lld), not mise.
# conda backend was noisy and missing clang-format/clang-tidy/lldb/lld.
{{-   template "render-tools" .mise.tools.infrastructure_darwin_cloud }}
{{- end }}
{{- template "render-tools" .mise.tools.infrastructure }}

# ── System Utilities (migrated from brew) ──
{{- template "render-tools" .mise.tools.system_utilities }}

# ── Container & Dev Tools ──
{{- template "render-tools" .mise.tools.container_tools }}
{{- if eq .chezmoi.os "darwin" }}
{{-   template "render-tools" .mise.tools.container_tools_darwin }}
{{- end }}
# ── Test Tools ──
{{- template "render-tools" .mise.tools.test_tools }}

# ── AI Agents & CLI Tools ──
# Claude Code CLI — managed by its native installer (`claude update`),
# NOT by mise. Installed at ~/.local/bin/claude → ~/.local/share/claude/versions/<ver>.
# See Issue #52 for migration rationale.
{{- template "render-tools" .mise.tools.ai_agents }}

# ── Migrated from bun/uv globals ──
{{- template "render-tools" .mise.tools.migrated_globals }}

# ── Vercel Labs ──
{{- template "render-tools" .mise.tools.vercel_labs }}

# ── LangChain Ecosystem (migrated from install-langchain-cli-tools.sh) ──
{{- template "render-tools" .mise.tools.langchain }}

# ── Agent Stack (migrated from install-agent-stack.sh) ──
{{- template "render-tools" .mise.tools.agent_stack }}

# ── TypeScript/LSP Tooling ──
{{- template "render-tools" .mise.tools.typescript_lsp }}

# ── Kubernetes ──
{{- template "render-tools" .mise.tools.kubernetes }}

[tool_alias]
devcontainer = "npm:@devcontainers/cli"

[hooks]
postinstall = "mise lock"
