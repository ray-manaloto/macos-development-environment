# Brewfile — managed by chezmoi
# Only formulae without mise backends + all casks + vscode extensions.
# CLI tools are managed by mise (see dot_config/mise/config.toml.tmpl).

# ── Taps ──
tap "homebrew/autoupdate"

# ── Formulae (no mise backend available) ──
brew "gnupg"
brew "curl"
brew "chafa"
brew "tree"

# ── C++ Toolchain (brew > mise conda — includes clang-format, clang-tidy, lldb) ──
brew "llvm"
brew "lld"

# ── Casks (GUI applications) ──
cask "gemini"
cask "ghostty"
cask "git-credential-manager"
cask "iterm2"
cask "jordanbaird-ice"
cask "mactex"
cask "opencode-desktop"
cask "osquery"
cask "sublime-text"
cask "swiftbar"
cask "wezterm"

