external-sources=true
# SC2006: backticks in heredoc/comment text (not command substitution)
# SC2012: ls in controlled paths (no special filenames)
# SC2015: A && B || C pattern used intentionally in validation scripts
# SC2016: intentional single-quoted strings in grep patterns (test assertions)
# SC2088: intentional tilde in error messages (human-readable, not path expansion)
disable=SC2006,SC2012,SC2015,SC2016,SC2034,SC2054,SC2086,SC2088,SC2155,SC2163,SC2295
