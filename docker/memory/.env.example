# docker/memory/.env.example
#
# Honcho v3.0.3 configuration for docker/memory/compose.yaml
# Copy to docker/memory/.env and fill in values.
#
# MODES:
# 1. API-ONLY (current): HONCHO_DB_PASSWORD only (LLM keys use dummy defaults)
# 2. SEMANTIC SEARCH: EMBED_MESSAGES=true + LLM_GEMINI_API_KEY (free tier)
# 3. FULL REASONING: Uncomment honcho-deriver in compose.yaml + full LLM setup
#
# See docs/research/trail/deep-reviews/honcho-deriver-config-guide.md for details.

## REQUIRED — Database & Cache

# PostgreSQL password for honcho-db service
HONCHO_DB_PASSWORD=changeme

## OPTIONAL — Embedding & Semantic Search
# Enable message embedding for vector similarity search.
# Requires LLM_GEMINI_API_KEY (free tier: ai.google.dev)
EMBED_MESSAGES=false
LLM_GEMINI_API_KEY=

## OPTIONAL — LLM API Keys (for semantic search or deriver)
# Only set keys for providers you actually use.

# Anthropic Claude family
LLM_ANTHROPIC_API_KEY=

# OpenAI GPT family
LLM_OPENAI_API_KEY=

# Google Gemini (used for embeddings if EMBED_MESSAGES=true)
# Already set above; duplicate here for reference
# LLM_GEMINI_API_KEY=

# Groq (experimental)
LLM_GROQ_API_KEY=

# Custom OpenAI-compatible endpoint (Ollama, LocalAI, etc.)
LLM_OPENAI_COMPATIBLE_BASE_URL=
LLM_OPENAI_COMPATIBLE_API_KEY=

# vLLM server
LLM_VLLM_BASE_URL=
LLM_VLLM_API_KEY=

## OPTIONAL — Provider Selection (for honcho-deriver)
# Only set these if you uncomment honcho-deriver in compose.yaml.
# Defaults match compose.yaml comments; override here if needed.

# Deriver (document embedding & representation)
# DERIVER_ENABLED=true
# DERIVER_PROVIDER=google
# DERIVER_MODEL=gemini-2.5-flash-lite
# DERIVER_BACKUP_PROVIDER=anthropic
# DERIVER_BACKUP_MODEL=claude-haiku-4-5

# Summary (session summarization)
# SUMMARY_ENABLED=true
# SUMMARY_PROVIDER=google
# SUMMARY_MODEL=gemini-2.5-flash

# Dream (autonomous hypothesis generation)
# DREAM_ENABLED=true
# DREAM_PROVIDER=anthropic
# DREAM_MODEL=claude-sonnet-4-20250514
# DREAM_DEDUCTION_MODEL=claude-haiku-4-5
# DREAM_INDUCTION_MODEL=claude-haiku-4-5

# Dialectic reasoning levels (minimal, low, medium, high, max)
# Use nested delimiter __ to set per-level values.
# Example (uncomment all levels if enabling deriver):
# DIALECTIC_LEVELS__minimal__PROVIDER=google
# DIALECTIC_LEVELS__minimal__MODEL=gemini-2.5-flash-lite
# DIALECTIC_LEVELS__low__PROVIDER=google
# DIALECTIC_LEVELS__low__MODEL=gemini-2.5-flash-lite
# DIALECTIC_LEVELS__medium__PROVIDER=anthropic
# DIALECTIC_LEVELS__medium__MODEL=claude-haiku-4-5
# DIALECTIC_LEVELS__high__PROVIDER=anthropic
# DIALECTIC_LEVELS__high__MODEL=claude-haiku-4-5
# DIALECTIC_LEVELS__max__PROVIDER=anthropic
# DIALECTIC_LEVELS__max__MODEL=claude-haiku-4-5

## OPTIONAL — Authentication (defaults: disabled)
# Only set if you enable AUTH_USE_AUTH=true in compose.yaml.
# AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=
