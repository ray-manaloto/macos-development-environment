amends "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["ruff"] = (Builtins.ruff) {
        exclude = List(".agents/skills/**")
    }
    ["ruff_format"] = (Builtins.ruff_format) {
        exclude = List(".agents/skills/**")
    }
    ["ty"] = (Builtins.ty) {
        exclude = List(".agents/skills/**")
    }
    ["shellcheck"] = Builtins.shellcheck
}

local validators = new Mapping<String, Step> {
    ["mde-validate"] {
        check = "uv run mde-py validate --all"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping { ...linters ...validators }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
