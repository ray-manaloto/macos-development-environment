{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchBundle",
  "type": "object",
  "required": [
    "date",
    "summary",
    "discovery_records",
    "pattern_records",
    "decision_records",
    "acceptance_records"
  ],
  "properties": {
    "date": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["source_classes", "repository_count", "non_repo_artifact_count"],
      "properties": {
        "source_classes": {"type": "array", "items": {"type": "string"}, "minItems": 3},
        "repository_count": {"type": "integer", "minimum": 10},
        "non_repo_artifact_count": {"type": "integer", "minimum": 20}
      },
      "additionalProperties": true
    },
    "discovery_records": {"type": "array", "minItems": 1},
    "pattern_records": {"type": "array", "minItems": 1},
    "decision_records": {"type": "array", "minItems": 1},
    "acceptance_records": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
