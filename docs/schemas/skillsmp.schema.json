{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skillsmp.schema.json",
  "title": "SkillsMP API Models",
  "description": "Combined schema for SkillsMP REST API responses: keyword search, AI search, and errors.",
  "$defs": {
    "Skill": {
      "type": "object",
      "required": ["id", "name", "author"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string", "default": "" },
        "githubUrl": { "type": "string", "default": "" },
        "skillUrl": { "type": "string", "default": "" },
        "stars": { "type": "integer", "default": 0 },
        "updatedAt": { "type": "string", "default": "" }
      }
    },
    "SkillSearchData": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/Skill" },
          "default": []
        },
        "total": { "type": "integer", "default": 0 },
        "page": { "type": "integer", "default": 1 },
        "limit": { "type": "integer", "default": 20 }
      }
    },
    "SkillSearchResponse": {
      "type": "object",
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/SkillSearchData" },
            { "type": "null" }
          ]
        }
      }
    },
    "AISearchResult": {
      "type": "object",
      "properties": {
        "file_id": { "type": "string", "default": "" },
        "filename": { "type": "string", "default": "" },
        "score": { "type": "number", "default": 0.0 }
      }
    },
    "AISearchData": {
      "type": "object",
      "properties": {
        "object": { "type": "string", "default": "" },
        "search_query": { "type": "string", "default": "" },
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/AISearchResult" },
          "default": []
        }
      }
    },
    "AISearchResponse": {
      "type": "object",
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/AISearchData" },
            { "type": "null" }
          ]
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "default": "" },
        "message": { "type": "string", "default": "" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "default": false },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/ErrorDetail" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
