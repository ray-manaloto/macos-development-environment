{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks guard-dotfile-edit",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks remind-chezmoi-commit",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
