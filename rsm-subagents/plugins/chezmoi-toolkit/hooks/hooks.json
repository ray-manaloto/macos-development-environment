{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-direct-dotfile-edit.sh \"${TOOL_INPUT_COMMAND}\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/remind-chezmoi-commit.sh \"${TOOL_INPUT_COMMAND}\"",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
