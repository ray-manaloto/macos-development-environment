{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergeDigest",
    "group:allNonMajor"
  ],
  "mise": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge mise tool patch/minor updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group Homebrew updates",
      "matchManagers": ["homebrew"],
      "groupName": "homebrew dependencies"
    }
  ],
  "labels": ["dependencies", "renovate"],
  "schedule": ["before 9am on Monday"]
}
