{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "admin": {
    "extensions": {
      "enabled": false
    },
    "mcp": {
      "enabled": false
    }
  },
  "general": {
    "defaultApprovalMode": "auto_edit"
  },
  "model": {
    "name": "auto-gemini-3"
  },
  "telemetry": {
    "enabled": true,
    "target": "local",
    "otlpEndpoint": "http://127.0.0.1:4318",
    "otlpProtocol": "http",
    "logPrompts": true
  }
}
