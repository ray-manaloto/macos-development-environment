{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "true",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "OTEL_RESOURCE_ATTRIBUTES": "project=mde,environment=dev"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks guard-install"
          },
          {
            "type": "command",
            "command": "uv run mde-py hooks guard-dotfile-edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in *.py) uv run ruff format \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "uv run mde-py hooks log-edit-outcome"
          },
          {
            "type": "command",
            "command": "uv run mde-py hooks validate-plugins"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks remind-chezmoi-commit"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks log-agent-event"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks log-agent-event"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks persist-transcripts",
            "timeout": 30
          },
          {
            "type": "prompt",
            "prompt": "Did the agent write all findings to files on disk? Check if any research findings, deep reviews, or provenance records were mentioned in the conversation but not written to docs/research/trail/. If findings exist only in context and not on disk, answer NO with the missing items. If all findings are persisted, answer YES.",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks persist-transcripts",
            "timeout": 30
          },
          {
            "type": "prompt",
            "prompt": "Before compaction, verify: (1) Are there any research findings in the conversation that have NOT been written to docs/research/trail/findings/*.yaml? (2) Are there any decisions or preferences that should be saved to auto memory? List any unpersisted items.",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks post-compact"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run mde-py hooks save-memory-on-clear",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "engineering@knowledge-work-plugins": true,
    "remember@claude-plugins-official": true,
    "design@knowledge-work-plugins": false,
    "nimble@knowledge-work-plugins": false,
    "voltagent-lang@voltagent-subagents": false,
    "voltagent-dev-exp@voltagent-subagents": false,
    "voltagent-qa-sec@voltagent-subagents": false,
    "chezmoi-toolkit@rsm-subagents": true,
    "devcontainer-toolkit@rsm-subagents": true,
    "hk-toolkit@rsm-subagents": true,
    "mise-toolkit@rsm-subagents": true,
    "research-review-toolkit@rsm-subagents": true,
    "test-generator@claude-community": true,
    "token-saver@claude-community": true,
    "safety-net@claude-community": true,
    "challenger@claude-community": true,
    "codebase-quality@claude-community": true,
    "bugbash@claude-community": true,
    "python-remote-debug-skill@claude-community": true,
    "marketplace-evaluator@rsm-subagents": true
  },
  "extraKnownMarketplaces": {
    "rsm-subagents": {
      "source": {
        "source": "directory",
        "path": "/Users/rmanaloto/dev/github/ray-manaloto/macos-development-environment/rsm-subagents"
      }
    }
  }
}
